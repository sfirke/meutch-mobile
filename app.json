{
  "expo": {
    "name": "Meutch",
    "slug": "meutch-mobile",
    "owner": "meutch",
    "scheme": "meutch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_m.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meutch.app"
    },
    "android": {
      "package": "com.meutch.app",
      "adaptiveIcon": {
        "backgroundColor": "#f6ad55",
        "foregroundImage": "./assets/logo_m.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/logo_m.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo_m.png",
          "resizeMode": "contain",
          "backgroundColor": "#f6ad55"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "014462f0-af16-48ed-8e83-4d9f383fffd8"
      }
    }
  }
}
